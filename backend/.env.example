JWT_SECRET=change-this-to-a-random-secret-in-production

# Set to "production" when deployed (enables Secure, cross-site session cookies).
# Leave unset/"development" for local development.
ENVIRONMENT=development

# The deployed frontend's origin, e.g. https://your-app.vercel.app
# Used for CORS. Defaults to http://localhost:3000 if unset.
FRONTEND_ORIGIN=http://localhost:3000
